# Copiar a .env y rellenar los valores antes de ejecutar docker compose up

# Base de datos (usuario postgres es el default de Easypanel)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto_por_una_contrasena_segura
POSTGRES_DB=zarvix

# Backend — obligatorias en producción
JWT_SECRET=genera_un_secreto_largo_y_aleatorio
ADMIN_PASSWORD=contrasena_para_el_panel_admin

# Nombre del empleado que crea el seed (opcional, por defecto "Empleado 1")
# SEED_EMPLEADO_NOMBRE=Juan García
